# Front-end settings for the Wipro laptop.
#
# Copy this file to `.env` in this same folder:
#
#     copy .env.wipro .env
#
# Nothing here needs filling in. Port 8000 was confirmed free on that machine,
# so the backend address is unchanged (T-80). Vite only passes variables
# through to the browser if their name starts with VITE_.
VITE_API_BASE_URL=http://localhost:8000
