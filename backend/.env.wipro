# Backend settings for the Wipro laptop.
#
# Copy this file to `.env` in this same folder and it should run as-is:
#
#     copy .env.wipro .env
#
# Only two lines below may need your attention, and both are marked FILL ME IN.
# Everything else is already set for that machine and was checked against a
# survey of it on 2026-09-09.

# ---- Application ----------------------------------------------------------
APP_NAME=loan-application-management
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_DIR=logs

# ---- Program identity (goes into every log line) --------------------------
POC_ID=POC-01
PHASE=5
ASSOCIATE_ID=rohit.sawant

# ---- Database -------------------------------------------------------------
DATABASE_URL=sqlite:///./loan_app.db

# ---- Security -------------------------------------------------------------
# FILL ME IN. Generate one and paste it here:
#     python -c "import secrets; print(secrets.token_hex(32))"
# The app runs without changing it, but every token it signs would be signed
# with a key that is written down in a public file, so do change it.
SECRET_KEY=change-me-to-a-64-character-random-string
ACCESS_TOKEN_EXPIRE_HOURS=24

# ---- Front-end -------------------------------------------------------------
# Vite's port. 5173 was confirmed free on the Wipro laptop, so it stays (T-80).
CORS_ORIGINS=http://localhost:5173

# ---- OpenTelemetry ---------------------------------------------------------
OTEL_SERVICE_NAME=poc-01-phase-1
OTEL_EXPORTER=console

# ---- The AI provider ------------------------------------------------------
# Gemini is the default, here and everywhere else. The survey confirmed
# generativelanguage.googleapis.com is reachable from the Wipro laptop, so this
# works there.
#
# Ollama is the fallback, for the day Gemini is blocked or the free tier's daily
# quota runs out. To switch: change this one line to `ollama` and re-run the
# ingest step, because each provider keeps its own separate ChromaDB collection
# and neither can read the other's. See SETUP-WIPRO.md step 6.
LLM_PROVIDER=gemini

# FILL ME IN. Free key from https://aistudio.google.com/app/apikey
# Without it the app still starts and Phase 1 works fully, but anything that
# asks the AI a question fails until you either paste a key here or switch the
# line above to `ollama`.
GOOGLE_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=models/gemini-embedding-001

# These two are the exact model strings the Wipro laptop already has pulled,
# tag included. They are NOT the same as this project's defaults, and a missing
# or wrong tag makes Ollama answer 404 (T-79). Confirmed by `ollama list` there.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3.5:0.8b
OLLAMA_EMBED_MODEL=nomic-embed-text:v1.5

# ---- The vector store -----------------------------------------------------
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=poc_01_loan_manual

# ---- Retrieval, fixed by the Phase 2 spec ---------------------------------
CHUNK_SIZE=512
CHUNK_OVERLAP=50
TOP_K_RESULTS=4

# ---- LangSmith tracing ----------------------------------------------------
# Off by default here. The survey found smith.langchain.com reachable from that
# machine, so if you want the two tracing tests (Phase 2 OBS-01 and OBS-04) to
# pass, set the flag to true and paste a free key from https://smith.langchain.com.
# The other eighteen Phase 2 tests do not need it.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=AI-Readiness-POC-01-P2

# ---- Where the agent finds the Phase 1 API --------------------------------
# Port 8000 was confirmed free on that machine, so this does not change.
API_BASE_URL=http://localhost:8000
AGENT_SERVICE_EMAIL=anita@bank.com
