# Copy this file to .env and fill in the blanks. Never commit .env.

# ---- Application ----------------------------------------------------------
APP_NAME=loan-application-management
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# ---- Program identity (goes into every log line) --------------------------
POC_ID=POC-01
PHASE=1
ASSOCIATE_ID=rohit.sawant

# ---- Database -------------------------------------------------------------
DATABASE_URL=sqlite:///./loan_app.db

# ---- Security -------------------------------------------------------------
# Generate a real one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-64-character-random-string
ACCESS_TOKEN_EXPIRE_HOURS=24

# ---- Front-end -------------------------------------------------------------
# Vite dev server. The trainer's docs say 3000; that is the old Create React App port.
CORS_ORIGINS=http://localhost:5173

# ---- OpenTelemetry ---------------------------------------------------------
OTEL_SERVICE_NAME=poc-01-phase-1
# console = print every span to the terminal (what the program wants to see)
# none    = spans off (quieter for tests)
OTEL_EXPORTER=console
