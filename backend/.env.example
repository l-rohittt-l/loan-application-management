# Copy this file to .env and fill in the blanks. Never commit .env.

# ---- Application ----------------------------------------------------------
APP_NAME=loan-application-management
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
# Keep a copy of the log on disk so a reference number shown in the app can
# still be looked up later. Rotates at 5 MB, keeps the last 5 files.
LOG_TO_FILE=true
LOG_DIR=logs

# ---- Program identity (goes into every log line) --------------------------
POC_ID=POC-01
PHASE=2
ASSOCIATE_ID=rohit.sawant

# ---- Database -------------------------------------------------------------
DATABASE_URL=sqlite:///./loan_app.db

# ---- Security -------------------------------------------------------------
# Generate a real one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-64-character-random-string
ACCESS_TOKEN_EXPIRE_HOURS=24

# ---- Front-end -------------------------------------------------------------
# Vite dev server. The trainer's docs say 3000; that is the old Create React App port.
CORS_ORIGINS=http://localhost:5173

# ---- OpenTelemetry ---------------------------------------------------------
OTEL_SERVICE_NAME=poc-01-phase-1
# console = print every span to the terminal (what the program wants to see)
# none    = spans off (quieter for tests)
OTEL_EXPORTER=console

# ---- The AI provider (Phase 2 onwards) ------------------------------------
# gemini | ollama. Gemini was blocked on the company network for six weeks
# once, so this is a setting rather than a hardcoded choice.
LLM_PROVIDER=gemini

# Get a free key at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=
# The trainer named gemini-2.0-flash and models/text-embedding-004. Google has
# withdrawn BOTH. These are the working replacements (see T-51).
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=models/gemini-embedding-001

# The local fallback. Needs Ollama installed and the two models pulled.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1
OLLAMA_EMBED_MODEL=nomic-embed-text

# ---- The vector store -----------------------------------------------------
CHROMA_PERSIST_DIR=./chroma_db
# Gemini uses this name exactly, because the trainer's tests open it by name.
# Ollama gets "_ollama" appended so the two never mix (T-46).
CHROMA_COLLECTION=poc_01_loan_manual

# ---- Retrieval, fixed by the Phase 2 spec ---------------------------------
CHUNK_SIZE=512
CHUNK_OVERLAP=50
TOP_K_RESULTS=4

# ---- LangSmith tracing ----------------------------------------------------
# Free key from https://smith.langchain.com. Two of the twenty Phase 2 tests
# need it; the other eighteen do not.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=AI-Readiness-POC-01-P2
